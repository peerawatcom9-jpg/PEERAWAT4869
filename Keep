-- UI Helper Functions
local function CreateSwitch(textKey, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -10, 0, 35)
    Frame.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
    Frame.Parent = Scroll
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.75, 0, 1, 0)
    Label.Position = UDim2.new(0.03, 0, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = TextData[currentLang][textKey]
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.SourceSans
    Label.TextSize = 14
    Label.Parent = Frame

    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 50, 0, 25)
    SwitchBtn.Position = UDim2.new(0.8, 0, 0.15, 0)
    SwitchBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    SwitchBtn.Text = "OFF"
    SwitchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SwitchBtn.Font = Enum.Font.SourceSansBold
    SwitchBtn.Parent = Frame
    Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(0, 12)

    local state = false
    SwitchBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            SwitchBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
            SwitchBtn.Text = "ON"
        else
            SwitchBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            SwitchBtn.Text = "OFF"
        end
        callback(state)
    end)
    return Label
end

local function CreateSlider(textKey, minVal, maxVal, defaultVal, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, -10, 0, 50)
    Frame.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
    Frame.Parent = Scroll
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -10, 0, 20)
    Label.Position = UDim2.new(0.03, 0, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = TextData[currentLang][textKey] .. ": " .. tostring(defaultVal)
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.SourceSans
    Label.TextSize = 14
    Label.Parent = Frame

    local SliderBtn = Instance.new("TextButton")
    SliderBtn.Size = UDim2.new(0.9, 0, 0, 15)
    SliderBtn.Position = UDim2.new(0.05, 0, 0.55, 0)
    SliderBtn.BackgroundColor3 = Color3.fromRGB(100, 0, 0)
    SliderBtn.Text = ""
    SliderBtn.Parent = Frame

    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new((defaultVal - minVal)/(maxVal - minVal), 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderFill.Parent = SliderBtn

    local dragging = false
    SliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local percent = math.clamp((input.Position.X - SliderBtn.AbsolutePosition.X) / SliderBtn.AbsoluteSize.X, 0, 1)
            local value = math.floor(minVal + (maxVal - minVal) * percent)
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            Label.Text = TextData[currentLang][textKey] .. ": " .. tostring(value)
            callback(value)
        end
    end)
    return Label
end

