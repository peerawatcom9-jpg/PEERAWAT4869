local L_Magnet = CreateSwitch("ItemMagnet", function(state)
    magnetItems = state
    task.spawn(function()
        while magnetItems do
            for _, v in pairs(workspace:GetChildren()) do
                if v:IsA("Tool") or v:IsA("BasePart") and v.Name:lower():find("item") or v.Name:lower():find("drop") then
                    if v:IsA("BasePart") then v.CFrame = RootPart.CFrame end
                    if v:IsA("Tool") and v:FindFirstChild("Handle") then v.Handle.CFrame = RootPart.CFrame end
                end
            end
            task.wait(0.5)
        end
    end)
end)

