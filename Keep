        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Parent = RootPart
        
        task.spawn(function()
            while isFlying and RootPart:FindFirstChild("PeerawatFly") do
                local camPos = workspace.CurrentCamera.CFrame.LookVector
                bv.Velocity = camPos * flySpeed
